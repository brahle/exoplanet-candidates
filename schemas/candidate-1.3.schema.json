{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brahle/exoplanet-candidates/blob/main/schemas/candidate-1.3.schema.json",
  "title": "Transit-like signal dossier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "target",
    "signal",
    "assessment",
    "novelty",
    "provenance",
    "reproducibility",
    "publication",
    "evidence",
    "history",
    "host",
    "fit"
  ],
  "properties": {
    "schema_version": {
      "const": "1.3"
    },
    "id": {
      "type": "string",
      "pattern": "^tic-[0-9]+-s[0-9]{2}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tic",
        "gaia_dr3",
        "aliases",
        "coordinates",
        "catalogue_association"
      ],
      "properties": {
        "tic": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "gaia_dr3": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+$",
          "description": "Null when no unambiguous Gaia DR3 association is established."
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "coordinates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ra_deg",
            "dec_deg",
            "frame",
            "epoch",
            "provenance"
          ],
          "properties": {
            "ra_deg": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 360
            },
            "dec_deg": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "frame": {
              "type": "string"
            },
            "epoch": {
              "type": "string"
            },
            "provenance": {
              "type": "string"
            }
          }
        },
        "catalogue_association": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "gaia_dr2",
            "method",
            "evidence"
          ],
          "properties": {
            "status": {
              "enum": [
                "associated",
                "unresolved",
                "query_failed",
                "missing_tic",
                "ambiguous_tic",
                "invalid_tic",
                "missing_dr2",
                "invalid_dr2",
                "missing_dr3",
                "ambiguous_dr3",
                "quality_limited"
              ]
            },
            "gaia_dr2": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]+$"
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period_d",
        "epoch_btjd",
        "epoch_bjd_tdb",
        "bjd_offset",
        "time_scale",
        "covariance_epoch_period_d2",
        "covariance_method",
        "duration_h",
        "depth_ppm",
        "model",
        "sectors",
        "covered_events",
        "limits"
      ],
      "properties": {
        "period_d": {
          "$ref": "#/$defs/measurement"
        },
        "epoch_btjd": {
          "$ref": "#/$defs/measurement"
        },
        "epoch_bjd_tdb": {
          "type": "number"
        },
        "bjd_offset": {
          "const": 2457000
        },
        "time_scale": {
          "const": "TDB"
        },
        "covariance_epoch_period_d2": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "covariance_method": {
          "type": "string",
          "minLength": 1
        },
        "duration_h": {
          "$ref": "#/$defs/provisional_measurement"
        },
        "depth_ppm": {
          "$ref": "#/$defs/provisional_measurement"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "sectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "covered_events": {
          "type": "integer",
          "minimum": 1
        },
        "limits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "source_localisation",
        "timing_consistency"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "unclassified_transit_like_signal",
            "false_positive",
            "known_signal",
            "planet_candidate",
            "validated_planet",
            "confirmed_planet"
          ]
        },
        "source_localisation": {
          "$ref": "#/$defs/status"
        },
        "timing_consistency": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "novelty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checked_utc",
        "evidence",
        "limits"
      ],
      "properties": {
        "status": {
          "enum": [
            "no_match_in_checked_sources",
            "previously_reported",
            "unresolved"
          ]
        },
        "checked_utc": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "analysis_date",
        "source_revisions",
        "runs",
        "input_lock"
      ],
      "properties": {
        "analysis_date": {
          "type": "string",
          "format": "date"
        },
        "source_revisions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "runs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "input_lock": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "command",
        "limits",
        "requirements_for_numerical_release"
      ],
      "properties": {
        "level": {
          "enum": [
            "evidence_inspection",
            "public_numerical_rerun"
          ]
        },
        "command": {
          "type": "string"
        },
        "limits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "requirements_for_numerical_release": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "first_public_utc",
        "release_url",
        "doi",
        "authors"
      ],
      "properties": {
        "state": {
          "enum": [
            "draft",
            "disclosed",
            "published"
          ]
        },
        "first_public_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "disclosure_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "release_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "version",
          "change"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "version": {
            "type": "string"
          },
          "change": {
            "type": "string"
          }
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "parameter_scope",
        "catalogue_target",
        "parameters",
        "dilution",
        "evidence",
        "limits"
      ],
      "properties": {
        "status": {
          "const": "unresolved"
        },
        "parameter_scope": {
          "const": "catalogue_aperture_target"
        },
        "catalogue_target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tic",
            "gaia_dr3"
          ],
          "properties": {
            "tic": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "gaia_dr3": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]+$"
            }
          }
        },
        "parameters": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "teff_K",
            "radius_Rsun",
            "mass_Msun",
            "tmag",
            "distance_pc"
          ],
          "properties": {
            "teff_K": {
              "allOf": [
                {
                  "$ref": "#/$defs/catalogue_parameter"
                },
                {
                  "properties": {
                    "unit": {
                      "const": "K"
                    }
                  }
                }
              ]
            },
            "radius_Rsun": {
              "allOf": [
                {
                  "$ref": "#/$defs/catalogue_parameter"
                },
                {
                  "properties": {
                    "unit": {
                      "const": "R_sun"
                    }
                  }
                }
              ]
            },
            "mass_Msun": {
              "allOf": [
                {
                  "$ref": "#/$defs/catalogue_parameter"
                },
                {
                  "properties": {
                    "unit": {
                      "const": "M_sun"
                    }
                  }
                }
              ]
            },
            "tmag": {
              "allOf": [
                {
                  "$ref": "#/$defs/catalogue_parameter"
                },
                {
                  "properties": {
                    "unit": {
                      "const": "mag"
                    }
                  }
                }
              ]
            },
            "distance_pc": {
              "allOf": [
                {
                  "$ref": "#/$defs/catalogue_parameter"
                },
                {
                  "properties": {
                    "unit": {
                      "const": "pc"
                    }
                  }
                }
              ]
            }
          }
        },
        "dilution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "target_flux_fraction"
          ],
          "properties": {
            "status": {
              "const": "unresolved"
            },
            "target_flux_fraction": {
              "type": "null"
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "physical_parameters_status",
        "shape_uncertainty",
        "evidence"
      ],
      "properties": {
        "model": {
          "const": "signed_exposure_sampled_trapezoid"
        },
        "physical_parameters_status": {
          "const": "not_fitted"
        },
        "shape_uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "parameter_order",
            "parameter_units",
            "reference_parameter_order",
            "reference_covariance",
            "epoch_covariance",
            "duration_error_h",
            "ingress_fraction_error",
            "jacobian_rank",
            "fit_at_bound",
            "degrees_of_freedom",
            "variance_inflation",
            "errors_calibrated",
            "method",
            "limits"
          ],
          "properties": {
            "status": {
              "const": "conditional_local_covariance"
            },
            "parameter_order": {
              "const": [
                "epoch_btjd",
                "period_d",
                "duration_d",
                "ingress_fraction"
              ]
            },
            "parameter_units": {
              "const": [
                "d",
                "d",
                "d",
                "dimensionless"
              ]
            },
            "reference_parameter_order": {
              "const": [
                "reference_epoch_btjd",
                "period_d",
                "duration_d",
                "ingress_fraction"
              ]
            },
            "reference_covariance": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              }
            },
            "epoch_covariance": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              }
            },
            "duration_error_h": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "ingress_fraction_error": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "jacobian_rank": {
              "const": 4
            },
            "fit_at_bound": {
              "const": false
            },
            "degrees_of_freedom": {
              "type": "integer",
              "minimum": 1
            },
            "variance_inflation": {
              "type": "number",
              "minimum": 1
            },
            "errors_calibrated": {
              "const": false
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "limits": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "error"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "error": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "supported",
            "contradicted",
            "unresolved"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provisional_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "error"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "error": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "description": "Null denotes an unavailable uncertainty, permitted only for provisional duration/depth measurements with an explicit limit."
        }
      }
    },
    "catalogue_parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "field",
        "error_fields",
        "uncertainty_method",
        "status",
        "error",
        "error_minus",
        "error_plus",
        "limits"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "enum": [
            "K",
            "R_sun",
            "M_sun",
            "mag",
            "pc"
          ]
        },
        "field": {
          "type": "string"
        },
        "error_fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "error",
            "error_minus",
            "error_plus"
          ],
          "properties": {
            "error": {
              "type": [
                "string",
                "null"
              ]
            },
            "error_minus": {
              "type": [
                "string",
                "null"
              ]
            },
            "error_plus": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "uncertainty_method": {
          "const": "Catalogue-reported"
        },
        "status": {
          "enum": [
            "reported",
            "missing",
            "invalid"
          ]
        },
        "error": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "error_minus": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "error_plus": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "description": "Version 1.2: pinned aperture catalogue association and stellar context; no implied physical host or planet parameters.",
  "allOf": [
    {
      "if": {
        "properties": {
          "signal": {
            "properties": {
              "duration_h": {
                "properties": {
                  "error": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "assessment": {
            "properties": {
              "disposition": {
                "const": "unclassified_transit_like_signal"
              }
            }
          },
          "signal": {
            "properties": {
              "limits": {
                "contains": {
                  "type": "string",
                  "pattern": "[Uu]ncertainty unavailable"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "signal": {
            "properties": {
              "depth_ppm": {
                "properties": {
                  "error": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "assessment": {
            "properties": {
              "disposition": {
                "const": "unclassified_transit_like_signal"
              }
            }
          },
          "signal": {
            "properties": {
              "limits": {
                "contains": {
                  "type": "string",
                  "pattern": "[Uu]ncertainty unavailable"
                }
              }
            }
          }
        }
      }
    }
  ]
}
