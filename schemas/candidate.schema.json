{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brahle/exoplanet-candidates/blob/main/schemas/candidate.schema.json",
  "title": "Transit-like signal dossier",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "title", "target", "signal", "assessment", "novelty", "provenance", "reproducibility", "publication", "evidence", "history"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^tic-[0-9]+-s[0-9]{2}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "title": {"type": "string", "minLength": 1},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["tic", "gaia_dr3", "aliases", "coordinates"],
      "properties": {
        "tic": {"type": "string", "pattern": "^[0-9]+$"},
        "gaia_dr3": {"type": "string", "pattern": "^[0-9]+$"},
        "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "coordinates": {
          "type": "object", "additionalProperties": false,
          "required": ["ra_deg", "dec_deg", "frame", "epoch", "provenance"],
          "properties": {
            "ra_deg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
            "dec_deg": {"type": "number", "minimum": -90, "maximum": 90},
            "frame": {"type": "string"}, "epoch": {"type": "string"}, "provenance": {"type": "string"}
          }
        }
      }
    },
    "signal": {
      "type": "object", "additionalProperties": false,
      "required": ["period_d", "epoch_btjd", "epoch_bjd_tdb", "bjd_offset", "time_scale", "covariance_epoch_period_d2", "covariance_method", "duration_h", "depth_ppm", "model", "sectors", "covered_events", "limits"],
      "properties": {
        "period_d": {"$ref": "#/$defs/measurement"},
        "epoch_btjd": {"$ref": "#/$defs/measurement"},
        "epoch_bjd_tdb": {"type": "number"},
        "bjd_offset": {"const": 2457000},
        "time_scale": {"const": "TDB"},
        "covariance_epoch_period_d2": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
        },
        "covariance_method": {"type": "string", "minLength": 1},
        "duration_h": {"$ref": "#/$defs/measurement"},
        "depth_ppm": {"$ref": "#/$defs/measurement"},
        "model": {"type": "string", "minLength": 1},
        "sectors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "covered_events": {"type": "integer", "minimum": 1},
        "limits": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["disposition", "source_localisation", "timing_consistency"],
      "properties": {
        "disposition": {"enum": ["unclassified_transit_like_signal", "false_positive", "known_signal", "planet_candidate", "validated_planet", "confirmed_planet"]},
        "source_localisation": {"$ref": "#/$defs/status"},
        "timing_consistency": {"$ref": "#/$defs/status"}
      }
    },
    "novelty": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "checked_utc", "evidence", "limits"],
      "properties": {
        "status": {"enum": ["no_match_in_checked_sources", "previously_reported", "unresolved"]},
        "checked_utc": {"type": "string", "format": "date-time"},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "limits": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object", "required": ["analysis_date", "source_revisions", "runs", "input_lock"],
      "properties": {
        "analysis_date": {"type": "string", "format": "date"},
        "source_revisions": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
        "runs": {"type": "object", "additionalProperties": {"type": "string"}},
        "input_lock": {"type": "string"}
      }, "additionalProperties": false
    },
    "reproducibility": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "command", "limits", "requirements_for_numerical_release"],
      "properties": {
        "level": {"enum": ["evidence_inspection", "public_numerical_rerun"]},
        "command": {"type": "string"},
        "limits": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "requirements_for_numerical_release": {"type": "array", "items": {"type": "string"}}
      }
    },
    "publication": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "first_public_utc", "release_url", "doi", "authors"],
      "properties": {
        "state": {"enum": ["draft", "published"]},
        "first_public_utc": {"type": ["string", "null"], "format": "date-time"},
        "release_url": {"type": ["string", "null"], "format": "uri"},
        "doi": {"type": ["string", "null"]},
        "authors": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "history": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["date", "version", "change"],
      "properties": {"date": {"type": "string", "format": "date"}, "version": {"type": "string"}, "change": {"type": "string"}}
    }}
  },
  "$defs": {
    "measurement": {
      "type": "object", "additionalProperties": false, "required": ["value", "error"],
      "properties": {"value": {"type": "number"}, "error": {"type": "number", "exclusiveMinimum": 0}}
    },
    "status": {
      "type": "object", "additionalProperties": false, "required": ["status", "reason", "evidence"],
      "properties": {
        "status": {"enum": ["supported", "contradicted", "unresolved"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
